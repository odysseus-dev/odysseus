# Odysseus dev-stack — environment overrides.
# Copy to .env (cp .env.example .env). Every value has a default in
# docker-compose.dev.yml, so .env is OPTIONAL. These are LOCAL DEV credentials
# only — never reuse them anywhere real.

# Host bind address for every published port. Loopback by default.
# Set to 0.0.0.0 ONLY if you want other devices on your LAN to reach these.
BIND=127.0.0.1

# ---- Ports (change if something on your host already uses them) ----
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
POSTGRES_PORT=5432
PGADMIN_PORT=5050
REDIS_PORT=6379
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# ---- Qdrant (vector DB) ----
QDRANT_PORT=6333
QDRANT_API_PORT=6334

# ---- pgvector (PostgreSQL + vectors) ----
PGVECTOR_PORT=5433
PGVECTOR_USER=dev
PGVECTOR_PASSWORD=devpass
PGVECTOR_DB=vectordb

# ---- MinIO (S3 object storage) ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ---- Ollama (local LLM) ----
OLLAMA_DEV_PORT=11435

# ---- Jupyter (notebooks) ----
JUPYTER_PORT=8888
JUPYTER_TOKEN=devtoken

# ---- PostgreSQL ----
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb

# ---- pgAdmin (web UI for Postgres) ----
PGADMIN_EMAIL=dev@local.test
PGADMIN_PASSWORD=devpass

# ---- MongoDB ----
MONGO_USER=dev
MONGO_PASSWORD=devpass
