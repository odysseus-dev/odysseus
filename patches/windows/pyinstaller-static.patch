 # ========= STATIC FILES =========
-os.makedirs(STATIC_DIR, exist_ok=True)
+def _resolve_windows_static_dir() -> str:
+    """Resolve bundled static assets for PyInstaller Windows builds.
+
+    Source runs still use the repository's ./static directory. Frozen Windows
+    executables need to look inside the extracted PyInstaller bundle instead of
+    relying on the current working directory.
+    """
+    if not getattr(sys, "frozen", False):
+        os.makedirs(STATIC_DIR, exist_ok=True)
+        return "static"
+
+    candidates = []
+    meipass = getattr(sys, "_MEIPASS", None)
+    if meipass:
+        candidates.append(Path(meipass) / "static")
+
+    exe_dir = Path(sys.executable).resolve().parent
+    candidates.append(exe_dir / "static")
+    candidates.append(exe_dir / "_internal" / "static")
+
+    for candidate in candidates:
+        if candidate.is_dir():
+            return str(candidate)
+
+    searched = "\n".join(str(path) for path in candidates)
+    raise RuntimeError(
+        "Static directory not found for Windows bundle. Searched:\n"
+        f"{searched}"
+    )
+
+
+STATIC_FILES_DIR = (
+    _resolve_windows_static_dir() if os.name == "nt" else "static"
+)
 
 
