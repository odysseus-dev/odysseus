    "requiresApprovalFor": [
      "create_memory",
      "edit_memory",
      "delete_memory",
      "project_binding",
      "canon_promotion"
    ],
    "blockedPatterns": [
      ".env",
      "auth.json",
      "app.db",
      "token",
      "secret",
      "private key",
      "password",
      ".ssh"
    ]
  },
  "skills": {
    "autoCreateAllowed": false,
    "autoPublishAllowed": false,
    "requiresApprovalFor": [
      "add_skill",
      "patch_skill",
      "delete_skill",
      "publish_skill"
    ],
    "allowedRecommendationOnly": true
  },
  "models": {
    "autoSwitchAllowed": false,
    "paidModelRequiresApproval": true,
    "externalApiRequiresApproval": true,
    "localModelPreferredForSensitiveWork": true,
