      "privacy",
      "cost",
      "latency",
      "code_reasoning",
      "long_context",
      "vision",
      "voice",
      "tool_use"
    ]
  },
  "boundaries": {
    "externalReads": false,
    "externalWrites": false,
    "connectorCalls": false,
    "secretsStored": false,
    "productionMutationLocked": true,
    "humanApprovalRequired": true
  }
