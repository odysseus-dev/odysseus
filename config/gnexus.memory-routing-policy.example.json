{
  "schema": "gnexus.memory-routing-policy.v1",
  "package": "JUNIPERUS090",
  "workspaceRoot": "C:\\Users\\iamcy\\CymaticsDev",
  "defaultMode": "governed_read_only",
  "memory": {
