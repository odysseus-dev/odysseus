+def odysseus_managed_refusal(project_root: Path) -> Optional[UpdateRefusal]:
+    """Refusal for a tree Odysseus manages (see ``hermes_cli.odysseus_managed``); ``None`` for every other install.
+
+    Applied to the mutating update surfaces only: ``--check`` and the dashboard check keep reporting versions."""
+    from hermes_cli.odysseus_managed import NONE, REMEDIATION, managed_state, refusal_message
+
+    state = managed_state(project_root)
+    if state == NONE:
+        return None
+    return UpdateRefusal(code="odysseus-managed", message=refusal_message(state), update_command=REMEDIATION)
+
