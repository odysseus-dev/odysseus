diff --git a/hermes_cli/odysseus_managed.py b/hermes_cli/odysseus_managed.py
new file mode 100644
index 0000000000..0b5be1df06
--- /dev/null
+++ b/hermes_cli/odysseus_managed.py
@@ -0,0 +1,54 @@
+"""Odysseus-managed install marker: the updater guard's single source of truth.
+
+Odysseus builds each Hermes release side by side (pinned source + reviewed patches) and activates it deliberately. A direct
+``hermes update``, ``/update``, dashboard update or ``hermes pm update`` run against such a tree would replace those patches, so
+the supported updater operations refuse it and point at the reviewed Odysseus process. Update *discovery* is left alone.
+
+This guards supported updater operations only. It is not a permission boundary: any process with the user's privileges can still
+change files on disk.
+
+The marker is a tracked file shipped by the reviewed update-protection patch, so every release Odysseus builds from the pin gets it
+automatically and ``patch_state`` still recognises the tree. A tree is Odysseus-managed when it carries ``.odysseus-managed.json`` or sits in the managed layout
+(``<component>/releases/<id>/src`` beside that release's ``release.json``). A marker that exists but cannot be read, or does not
+say ``managed_by: odysseus``, still counts as managed (``invalid``): a damaged marker is never permission to update. A tree with
+neither signal is an independent install and is untouched.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+MARKER_NAME = ".odysseus-managed.json"
+NONE, MANAGED, INVALID = "none", "managed", "invalid"
+
+REFUSAL_MESSAGE = (
+    "This Hermes installation is managed by Odysseus. Direct updates are disabled to protect custom integrations. "
+    "Use the reviewed Odysseus update process."
+)
+INVALID_SUFFIX = " (The managed-install marker is damaged, so updates stay disabled until it is repaired by that process.)"
+REMEDIATION = "Use the reviewed Odysseus update process (scripts/hermes-webapp-component.py)"
+
+
+def managed_state(project_root) -> str:
+    """``none`` (independent install), ``managed`` or ``invalid`` (marker present but unusable). Never raises."""
+    try:
+        root = Path(project_root)
+        marker = root / MARKER_NAME
+        if marker.exists():
+            try:
+                data = json.loads(marker.read_text(encoding="utf-8-sig"))
+            except (OSError, ValueError):
+                return INVALID
+            if isinstance(data, dict) and data.get("managed_by") == "odysseus":
+                return MANAGED
+            return INVALID
+        if root.parent.parent.name == "releases" and (root.parent / "release.json").is_file():
+            return MANAGED
+    except OSError:
+        return NONE
+    return NONE
+
+
+def refusal_message(state: str) -> str:
+    return REFUSAL_MESSAGE + (INVALID_SUFFIX if state == INVALID else "")
