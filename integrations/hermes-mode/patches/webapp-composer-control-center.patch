@@ -0,0 +1,11 @@
+import { atom } from 'nanostores'
+
+import type { UsageStats } from '@/types/hermes'
+
+/** The context gauge the status bar already computes (measured breakdown, else the streamed usage). Published once so the
+ *  composer's ring reads the same numbers with no extra request or timer. */
+export const $composerContextGauge = atom<null | UsageStats>(null)
+
+/** The workspace mutation the app already owns (`session.cwd.set`, or the new-chat target for a draft), handed to the
+ *  composer's workspace chip so it never re-implements cwd handling. */
+export const $composerWorkspaceBridge = atom<{ changeSessionCwd?: (cwd: string, sessionId?: string) => Promise<void> }>({})
