@@ -0,0 +1,61 @@
+"""Contract: ``usage.accounts`` (account-level provider allowances; handler in ``tui_gateway/methods_session.py``, logic in
+``gateway/usage_accounts.py``) and the cost rows carried by ``Usage.cost_breakdown``."""
+
+from __future__ import annotations
+
+from .base import Params, Result, WireEnum
+from .registry import method
+
+
+class UsageAccountState(WireEnum):
+    ok = "ok"
+    stale = "stale"
+    unavailable = "unavailable"
+    auth_required = "auth_required"
+    unsupported = "unsupported"
+
+
+class UsageAccountWindow(Result):
+    """One allowance window. ``used_percent`` is None when the provider reports a window without a figure."""
+
+    label: str
+    used_percent: float | None = None
+    remaining_percent: float | None = None
+    resets_at: str | None = None
+    scope: str = "account"
+    detail: str | None = None
+
+
+class UsageAccountProvider(Result):
+    provider: str
+    label: str
+    state: UsageAccountState
+    scope: str = "account"
+    windows: list[UsageAccountWindow] = []
+    details: list[str] = []
+    reason: str | None = None
+    source: str | None = None
+    plan: str | None = None
+    fetched_at: str | None = None
+    age_s: float | None = None
+    can_refresh: bool = False
+    refreshing: bool = False
+    retry_in_s: int = 0
+
+
+class UsageAccountsParams(Params):
+    profile: str | None = None
+    refresh: str | None = None
+    pinned: list[str] = []
+
+
+class UsageAccountsResult(Result):
+    generated_at: float
+    scope: str
+    current_provider: str | None = None
+    providers: list[UsageAccountProvider]
+
+
+method("usage.accounts", params=UsageAccountsParams, result=UsageAccountsResult,
+       doc="Account-level provider allowances (sanitized; credentials stay in the gateway). Due providers refresh in the background; "
+           "`refresh` forces one provider (throttled). Never runs model inference.")
