+@method("usage.accounts")
+@_profile_scoped
+def _(rid, params: dict) -> dict:
+    """Account-level allowances for the AI Usage page. Sanitized by ``gateway/usage_accounts.py``: no credential or raw provider body is returned,
+    due providers refresh in the background (Hermes' own 120 s cadence + failure backoff) and ``refresh`` forces one, throttled. No inference."""
+    try:
+        from gateway.usage_accounts import accounts_view
+        pinned = [str(p) for p in (params.get("pinned") or []) if isinstance(p, str)][:12]
+        refresh = params.get("refresh")
