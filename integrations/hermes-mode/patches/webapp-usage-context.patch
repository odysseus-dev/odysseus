diff --git a/apps/desktop/src/app/chat/composer/context-popover.tsx b/apps/desktop/src/app/chat/composer/context-popover.tsx
new file mode 100644
index 0000000000..a81a7fba19
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/context-popover.tsx
@@ -0,0 +1,149 @@
+import { useStore } from '@nanostores/react'
+import { useEffect, useRef, useState } from 'react'
+import { useNavigate } from 'react-router'
+
+import { Button } from '@/components/ui/button'
+import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover'
+import { pluginSettingsHref } from '@/contrib/settings-pages'
+import { cn } from '@/lib/utils'
+import { requestGatewayForActiveRoute } from '@/store/active-route-request'
+import { $composerContextGauge } from '@/store/composer-control-center'
+import { $currentModel } from '@/store/session'
+import type { UsageStats } from '@/types/hermes'
+
+import { compactTokens, contextFacts, COST_KIND_LABEL, type ContextFacts, ageLabel } from './control-center-utils'
+
+interface Props {
+  children: React.ReactNode
+  profile?: null | string
+  sessionId?: null | string
+}
+
+const CACHE_MS = 15_000
+const detailCache = new Map<string, { at: number; usage: UsageStats }>()
+
+/** What the ring opens: where the numbers came from, compression and the cost of THIS conversation. The ring's own figure is read from the
+ *  shared gauge; the compression and cost facts are asked of the gateway once per open (cached 15 s), so nothing polls. */
+export function ContextPopover({ children, profile, sessionId }: Props) {
+  const gauge = useStore($composerContextGauge)
+  const model = useStore($currentModel)
+  const navigate = useNavigate()
+  const [open, setOpen] = useState(false)
+  const [detail, setDetail] = useState<null | { sessionId: string; usage: UsageStats }>(null)
+  const [failed, setFailed] = useState(false)
+  const latest = useRef(sessionId)
+  latest.current = sessionId
+
+  useEffect(() => {
+    if (!open || !sessionId) {
+      return
+    }
+
+    const hit = detailCache.get(sessionId)
+
+    if (hit && Date.now() - hit.at < CACHE_MS) {
+      setDetail({ sessionId, usage: hit.usage })
+
+      return
+    }
+
+    setFailed(false)
+    requestGatewayForActiveRoute<{ usage?: UsageStats }>(profile || 'default', 'session.info', { session_id: sessionId })
+      .then(info => {
+        if (info?.usage) {
+          detailCache.set(sessionId, { at: Date.now(), usage: info.usage })
+
+          if (latest.current === sessionId) {
+            setDetail({ sessionId, usage: info.usage })
+          }
+        }
+      })
+      .catch(() => latest.current === sessionId && setFailed(true))
+  }, [open, profile, sessionId])
+
+  // Never show another conversation's numbers: detail is honoured only for the session it was fetched for.
+  const facts = contextFacts(gauge, detail && detail.sessionId === sessionId ? detail.usage : null, model)
+
+  return (
+    <Popover onOpenChange={setOpen} open={open}>
+      <PopoverTrigger asChild>{children}</PopoverTrigger>
+      <PopoverContent align="end" className="w-80 max-w-[calc(100vw-1.5rem)] p-3 text-[0.75rem]" data-slot="composer-context-popover" side="top">
+        <Facts failed={failed} facts={facts} />
+        <div className="mt-2 flex justify-end">
+          <Button
+            onClick={() => {
+              setOpen(false)
+              navigate(pluginSettingsHref('odysseus-usage'))
+            }}
+            size="xs"
+            variant="ghost"
+          >
+            AI Usage and costs
+          </Button>
+        </div>
+      </PopoverContent>
+    </Popover>
+  )
+}
+
+function Row({ label, value, hint }: { hint?: string; label: string; value: React.ReactNode }) {
+  return (
+    <div className="flex items-baseline justify-between gap-3 py-0.5">
+      <span className="shrink-0 text-(--ui-text-tertiary)">{label}</span>
+      <span className="min-w-0 text-right text-(--ui-text-primary)" title={hint}>
+        {value}
+      </span>
+    </div>
+  )
+}
+
+function Facts({ facts, failed }: { facts: ContextFacts; failed: boolean }) {
+  return (
+    <div className="grid gap-2" data-slot="context-facts">
+      <div>
+        <p className="font-medium text-(--ui-text-primary)">Context window</p>
+        {facts.known ? (
+          <>
+            <Row
+              label="Used"
+              value={`${facts.estimated ? '~' : ''}${compactTokens(facts.used)} / ${compactTokens(facts.max)} (${facts.estimated ? '~' : ''}${facts.percent}%)`}
+            />
+            <Row label="Remaining" value={`${facts.estimated ? '~' : ''}${compactTokens(facts.max - facts.used)} (${100 - facts.percent}%)`} />
+          </>
+        ) : (
+          <p className="py-0.5 text-(--ui-text-secondary)">{facts.unavailable}</p>
+        )}
+        <Row label="Input tokens" value={facts.inputSource} />
+        <Row label="Window size" value={facts.windowSource} />
+        {facts.note && <p className="pt-1 text-(--ui-text-tertiary)">{facts.note}</p>}
+      </div>
+
+      <div>
+        <p className="font-medium text-(--ui-text-primary)">Automatic compression</p>
+        <Row label="Status" value={facts.compression.enabled === null ? 'Not reported' : facts.compression.enabled ? 'On' : 'Off'} />
+        {facts.compression.threshold && <Row hint={facts.compression.thresholdSource} label="Starts at" value={facts.compression.threshold} />}
+        <Row label="Compactions" value={facts.compression.count === null ? 'Not reported' : String(facts.compression.count)} />
+        {facts.compression.last !== null && <Row label="Last" value={ageLabel(facts.compression.last)} />}
+        {facts.compression.error && <p className="pt-1 text-(--dt-destructive,#c0392b)">Last error: {facts.compression.error}</p>}
+        {facts.compression.cooldown !== null && <p className="pt-1 text-(--ui-text-secondary)">Paused after an error until {new Date(facts.compression.cooldown * 1000).toLocaleTimeString()}.</p>}
+      </div>
+
+      <div>
+        <p className="font-medium text-(--ui-text-primary)">This conversation&rsquo;s cost</p>
+        {facts.costs.length === 0 ? (
+          <p className="py-0.5 text-(--ui-text-secondary)">{failed ? 'Cost details could not be loaded.' : 'No priced usage recorded yet.'}</p>
+        ) : (
+          facts.costs.map(cost => (
+            <Row
+              hint={cost.sources}
+              key={cost.kind}
+              label={COST_KIND_LABEL[cost.kind] ?? cost.kind}
+              value={<span className={cn(cost.kind === 'unpriced' && 'text-(--ui-text-secondary)')}>{cost.label}</span>}
+            />
+          ))
+        )}
+        <p className="pt-1 text-(--ui-text-tertiary)">Only an amount labelled &ldquo;Billed&rdquo; was charged. API-equivalent values are not charges.</p>
+      </div>
+    </div>
+  )
+}
