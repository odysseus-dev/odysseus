+++ b/apps/desktop/src/app/chat/composer/control-center-utils.ts
@@ -10,6 +10,100 @@ export interface ContextGaugeView {
   tooltip: string
 }
 
+export const compactTokens = (n: number): string => compact(n)
+
+export const COST_KIND_LABEL: Record<string, string> = {
+  billed: 'Billed by provider',
+  estimated_api: 'Estimated API cost',
+  subscription_equivalent: 'API-equivalent (not charged)',
+  included: 'Included / free',
+  unpriced: 'Price unknown'
+}
+
+export function ageLabel(epochSeconds: number): string {
+  const s = Math.max(0, Math.round(Date.now() / 1000 - epochSeconds))
+
+  return s < 90 ? 'just now' : s < 5400 ? `${Math.round(s / 60)} min ago` : s < 129_600 ? `${Math.round(s / 3600)} h ago` : `${Math.round(s / 86_400)} d ago`
+}
+
+const INPUT_SOURCE: Record<string, string> = {
+  provider_anchor: 'Provider-reported',
+  provider_anchor_plus_estimate: 'Provider reading + estimate for newer messages',
+  provider_usage: 'Provider-reported',
+  local_estimate: 'Estimated locally',
+  transcript_estimate: 'Estimated from the transcript'
+}
+
+const UNAVAILABLE: Record<string, string> = {
+  no_provider_reading: 'No provider reading is stored for this conversation yet. It appears after the next reply.',
+  transcript_changed: 'The stored reading no longer matches the transcript. It updates after the next reply.',
+  window_unknown: "This model's context window is not known, so no percentage is shown.",
+  empty: 'This conversation has no messages yet.',
+  unreadable: 'The stored conversation could not be read.'
+}
+
+export interface ContextFacts {
+  compression: {
+    cooldown: null | number
+    count: null | number
+    enabled: boolean | null
+    error: null | string
+    last: null | number
+    threshold: null | string
+    thresholdSource: string
+  }
+  costs: { kind: string; label: string; sources: string }[]
+  estimated: boolean
+  inputSource: string
+  known: boolean
+  max: number
+  note: null | string
+  percent: number
+  unavailable: string
+  used: number
+  windowSource: string
+}
+
+/** The popover's facts. `gauge` is the live ring figure; `detail` is the gateway's `session.info` usage for THIS conversation (compression,
+ *  cost, and where each figure came from). A window is never invented: without one the ring reads unavailable and the known token count is shown. */
+export function contextFacts(gauge: null | undefined | UsageStats, detail: null | undefined | UsageStats, currentModel = ''): ContextFacts {
+  const view = contextGaugeView(gauge)
+  const known = view.state !== 'unavailable' && Boolean(gauge?.context_max)
+  const used = known ? (gauge?.context_used ?? 0) : 0
+  const max = known ? (gauge?.context_max ?? 0) : 0
+  const estimated = known ? Boolean(gauge?.context_estimated) : false
+  const source = detail?.context_input_source ?? (known ? (estimated ? 'local_estimate' : 'provider_usage') : '')
+  const reason = detail?.context_unavailable_reason ?? ''
+  const staleModel = Boolean(currentModel && gauge?.model && gauge.model !== currentModel)
+  const windowKnown = known || Boolean(detail?.context_max_known)
+  const windowSource = detail?.context_window_source ?? (known ? 'model_metadata' : 'unknown')
+  const threshold = detail?.compression_threshold_tokens
+  const percent = detail?.compression_threshold_percent
+
+  return {
+    compression: {
+      cooldown: detail?.compression_cooldown_until ?? null,
+      count: detail?.compressions ?? gauge?.compressions ?? null,
+      enabled: detail?.compression_enabled ?? null,
+      error: detail?.compression_error ?? null,
+      last: detail?.last_compaction_at ?? null,
+      threshold: threshold ? `${percent ? `${percent}% = ` : ''}${compact(threshold)} tokens` : percent ? `${percent}% of the window` : null,
+      thresholdSource: detail?.compression_threshold_source === 'compressor' ? "This model's active compressor" : 'Your configured compression threshold'
+    },
+    costs: (detail?.cost_breakdown ?? []).map(row => ({ kind: row.kind, label: row.label, sources: (row.sources ?? []).join(', ') || 'no price source' })),
+    estimated,
+    inputSource: source ? (INPUT_SOURCE[source] ?? source) : 'Not available',
+    known,
+    max,
+    note: staleModel ? 'The model changed; these figures update after the next reply.' : (detail?.context_note ? 'The stored reading no longer matched the transcript, so part of this is estimated.' : null),
+    percent: known ? Math.max(0, Math.min(100, Math.round(gauge?.context_percent ?? (used / max) * 100))) : 0,
+    unavailable: detail?.context_known_tokens
+      ? `About ${compact(detail.context_known_tokens)} tokens are in use, but ${UNAVAILABLE.window_unknown}`
+      : (UNAVAILABLE[reason] ?? 'Context usage is not available for this conversation yet. It appears after the next reply.'),
+    windowSource: windowKnown ? (windowSource === 'config' ? 'Set in your config' : windowSource === 'model_metadata' ? "From the model's metadata" : 'Not known') : 'Not known'
+  }
+}
+
 const compact = (n: number): string => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M` : n >= 1_000 ? `${Math.round(n / 100) / 10}k` : String(Math.round(n)))
 
 /** What the composer's context ring shows. A figure is only shown when the backend sent a context window; a backend estimate is
