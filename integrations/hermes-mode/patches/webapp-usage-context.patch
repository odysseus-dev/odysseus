index 0000000000..cc0fa602e3
--- /dev/null
+++ b/gateway/usage_accounts.py
@@ -0,0 +1,220 @@
+"""Account-level allowances for the Desktop's AI Usage page: a sanitized view over ``agent.account_usage``.
+
+Nothing here talks to a provider on its own. Every figure comes from ``agent.account_usage.fetch_account_usage`` (the same call ``/usage`` makes),
+whose results Hermes already keeps in ``agent.account_usage_cache``: the last snapshot WITH windows survives a failed refresh and counts as stale
+after ``SNAPSHOT_STALE_AFTER_S``. This module adds only (a) a per-provider refresh throttle with failure backoff, (b) the reason a refresh failed,
+which the cache does not keep, and (c) the wire shape. Credentials, tokens and raw provider bodies never leave this process: windows, a short
+display name and plain-text details are the whole output.
+
+The built-in Anthropic fetcher is not offered here: it identifies itself to Anthropic as another client. Claude is reported through the
+Claude Code provider's own ``fetch_account_usage`` hook (Claude Code answering its own ``get_usage``, zero inference) or as "unsupported".
+Account allowances are NOT per-session token counts and are never derived from them.
+"""
+from __future__ import annotations
+
+import contextlib
+import threading
+import time
+from datetime import datetime, timezone
+
+# Shown first, in this order; other providers that can report usage follow.
+CLAUDE_PLUGIN = "claude-subscription-directsdk-experimental"
+PRIORITY = ("openai-codex", CLAUDE_PLUGIN, "anthropic", "openrouter", "nous")
+NO_CLAUDE_SOURCE = "Claude usage unavailable — no supported usage source configured."
+SCOPE = ("Account-level allowance as reported by the provider. It can include use from other apps and devices, "
+         "and is not computed from this Hermes installation's token counts.")
+MIN_REFRESH_S = 20.0          # a manual Refresh inside this window is answered from the cache
+BACKOFF_STEPS_S = (60.0, 300.0, 900.0)
+REFRESH_AFTER_S = 120.0       # same cadence Hermes' own picker uses
+
+_lock = threading.Lock()
+_state: dict[str, dict] = {}   # slug -> {tried, ok, reason, failures, inflight}
+
+
+def _display_name(slug: str) -> str:
+    with contextlib.suppress(Exception):
+        from providers import get_provider_profile
+        profile = get_provider_profile(slug)
+        if profile is not None and getattr(profile, "display_name", None):
+            return str(profile.display_name)
+    return {"openai-codex": "ChatGPT / Codex", "openrouter": "OpenRouter", "nous": "Nous Portal", "anthropic": "Anthropic API"}.get(slug, slug)
+
+
+def _pool_slugs() -> list[str]:
+    with contextlib.suppress(Exception):
+        from hermes_cli.auth import read_credential_pool
+        return [str(slug) for slug, entries in read_credential_pool().items() if entries]
+    return []
+
+
+def _current_provider() -> str:
+    with contextlib.suppress(Exception):
+        from hermes_cli.config import load_config_readonly
+        model = (load_config_readonly() or {}).get("model") or {}
+        return str(model.get("provider") or "").strip().lower() if isinstance(model, dict) else ""
+    return ""
+
+
+def provider_slugs(extra=()) -> list[str]:
+    seen: list[str] = []
+    for slug in (*PRIORITY, _current_provider(), *_pool_slugs(), *extra):
+        slug = str(slug or "").strip().lower()
+        if slug and slug not in seen:
+            seen.append(slug)
+    return [slug for slug in seen if slug in PRIORITY or _can_report(slug)]
+
+
+def _can_report(slug: str) -> bool:
+    if slug == "anthropic":
+        return False  # excluded on purpose, see module docstring
+    if slug == "nous":
+        return True
+    with contextlib.suppress(Exception):
+        from agent.account_usage_cache import has_account_usage
+        return bool(has_account_usage(slug))
+    return False
+
+
+def _nous_snapshot():
+    """Portal credits through Hermes' own builder; None unless a portal account is signed in (the free tier has none)."""
+    from agent.account_usage import _fetch_portal_account, _nous_logged_in, build_nous_credits_snapshot
+    if not _nous_logged_in():
+        return None
+    account = _fetch_portal_account(10.0)
+    return build_nous_credits_snapshot(account) if account is not None and getattr(account, "logged_in", False) else None
+
+
+def _fetch(slug: str):
+    if slug == "nous":
+        snapshot = _nous_snapshot()
+        if snapshot is not None and snapshot.windows:
+            from agent.account_usage_cache import remember_account_usage
+            remember_account_usage("nous", snapshot)
+        return snapshot
+    from agent.account_usage import fetch_account_usage
+    return fetch_account_usage(slug)
+
+
+def _run_refresh(slug: str) -> None:
+    now = time.monotonic()
+    ok, reason = False, None
+    try:
+        snapshot = _fetch(slug)
+        if snapshot is None:
+            reason = "not_signed_in"
+        elif snapshot.unavailable_reason:
+            reason = str(snapshot.unavailable_reason)[:240]
+        elif not (snapshot.windows or snapshot.details):
+            reason = "The provider returned no usage figures."
+        else:
+            ok = True
+    except Exception as exc:  # a provider failure must never reach the caller as an exception
+        reason = "The usage check failed (%s)." % type(exc).__name__
+    with _lock:
+        entry = _state.setdefault(slug, {"failures": 0})
+        entry.update(tried=now, ok=ok, reason=reason, inflight=False)
+        entry["failures"] = 0 if ok else min(entry.get("failures", 0) + 1, len(BACKOFF_STEPS_S))
+
+
+def _wait_s(entry: dict) -> float:
+    failures = entry.get("failures", 0)
+    return BACKOFF_STEPS_S[min(failures, len(BACKOFF_STEPS_S)) - 1] if failures else REFRESH_AFTER_S
+
+
+def _due(slug: str, now: float, manual: bool) -> bool:
+    entry = _state.get(slug)
+    if entry is None:
+        return True
+    if entry.get("inflight"):
+        return False
+    return now - entry.get("tried", 0.0) >= (MIN_REFRESH_S if manual else _wait_s(entry))
+
+
+def request_refresh(slug: str, *, manual: bool = False, wait: bool = False) -> bool:
+    """Start a refresh if one is due. ``wait`` blocks (bounded by the fetchers' own timeouts) for a manual Refresh."""
+    now = time.monotonic()
+    if not _can_report(slug):
+        return False
+    with _lock:
+        if not _due(slug, now, manual):
+            return False
+        _state.setdefault(slug, {"failures": 0})["inflight"] = True
+    if wait:
+        _run_refresh(slug)
+    else:
+        threading.Thread(target=_run_refresh, args=(slug,), name="hermes-usage-accounts", daemon=True).start()
+    return True
+
+
+def _iso(value):
+    if value is None:
+        return None
+    with contextlib.suppress(Exception):
+        return (value if value.tzinfo else value.replace(tzinfo=timezone.utc)).isoformat()
+    return None
+
+
+def _windows(snapshot) -> list[dict]:
+    rows = []
+    for w in getattr(snapshot, "windows", ()) or ():
+        used = w.used_percent
+        valid = isinstance(used, (int, float)) and used == used
+        used = max(0.0, min(100.0, float(used))) if valid else None
+        rows.append({"label": str(w.label), "used_percent": used, "remaining_percent": None if used is None else round(100.0 - used, 1),
+                     "resets_at": _iso(w.reset_at), "scope": str(getattr(w, "scope", "account") or "account"),
+                     "detail": str(w.detail)[:200] if w.detail else None})
+    return rows
+
+
+def provider_view(slug: str, now: float | None = None) -> dict:
+    """One provider's row. ``state``: ok | stale | unavailable | auth_required | unsupported."""
+    now = time.monotonic() if now is None else now
+    base = {"provider": slug, "label": _display_name(slug), "scope": "account", "windows": [], "details": [], "reason": None,
+            "source": None, "plan": None, "fetched_at": None, "age_s": None, "can_refresh": False, "refreshing": False, "retry_in_s": 0}
+    if slug == "anthropic":
+        return {**base, "label": "Claude (Anthropic API)", "state": "unsupported", "reason": NO_CLAUDE_SOURCE}
+    if not _can_report(slug):
+        return {**base, "state": "unsupported", "reason": NO_CLAUDE_SOURCE if slug == CLAUDE_PLUGIN else
+                "This provider does not expose an account usage endpoint Hermes can read."}
+    from agent.account_usage_cache import cached_account_usage, snapshot_is_stale
+    snapshot = cached_account_usage(slug)
+    with _lock:
+        entry = dict(_state.get(slug) or {})
+    base["can_refresh"] = True
+    base["refreshing"] = bool(entry.get("inflight"))
+    if entry.get("tried") is not None:
+        base["retry_in_s"] = max(0, int(_wait_s(entry) - (now - entry["tried"])))
+    reason = entry.get("reason")
+    failed = entry.get("ok") is False and entry.get("tried") is not None
+    if snapshot is not None and (snapshot.windows or snapshot.details):
+        age = None
+        with contextlib.suppress(Exception):
+            age = max(0.0, (datetime.now(timezone.utc) - snapshot.fetched_at.astimezone(timezone.utc)).total_seconds())
+        stale = snapshot_is_stale(snapshot) or failed
+        note = None
+        if stale:
+            note = "The latest refresh failed; showing the last good reading." if failed else "This reading is older than 15 minutes."
+            if failed and reason and reason != "not_signed_in":
+                note += " " + reason
+        return {**base, "state": "stale" if stale else "ok", "windows": _windows(snapshot), "details": [str(d)[:200] for d in snapshot.details],
+                "plan": snapshot.plan, "source": snapshot.source, "fetched_at": _iso(snapshot.fetched_at), "age_s": age, "reason": note}
+    if reason == "not_signed_in":
+        return {**base, "state": "auth_required", "reason": "Not signed in to this provider in Hermes."}
+    if reason:
+        return {**base, "state": "unavailable", "reason": reason}
+    return {**base, "state": "unavailable", "reason": "Not checked yet." if entry.get("tried") is None else "No usage figures were returned."}
+
+
+def accounts_view(*, refresh: str | None = None, pinned=(), wait: bool = True) -> dict:
+    """The ``usage.accounts`` result. Providers that are due refresh in the background (never blocking the reply); ``refresh`` names one the
+    user asked for, answered after at most that fetcher's own timeout."""
+    slugs = provider_slugs(pinned)
+    manual = str(refresh or "").strip().lower()
+    for slug in slugs:
+        if slug != manual:
+            request_refresh(slug)
+    if manual:
+        request_refresh(manual, manual=True, wait=wait)
+    now = time.monotonic()
+    return {"generated_at": time.time(), "scope": SCOPE, "current_provider": _current_provider() or None,
+            "providers": [provider_view(slug, now) for slug in slugs]}
