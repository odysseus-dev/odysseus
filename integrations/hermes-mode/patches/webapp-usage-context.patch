--- a/gateway/session_usage.py
+++ b/gateway/session_usage.py
@@ -10,6 +10,8 @@ from __future__ import annotations
 
 import contextlib
 import dataclasses
+import json
+import threading
 import time
 
 _COUNTERS = (("input_tokens", "session_input_tokens"), ("output_tokens", "session_output_tokens"),
@@ -222,9 +224,255 @@ def snapshot_usage(authority, ref, agent) -> dict | None:
     if agent is not None and getattr(agent, "session_api_calls", 0):
         result = usage_stats(agent)
