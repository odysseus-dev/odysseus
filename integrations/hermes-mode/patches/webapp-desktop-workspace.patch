+import { describe, expect, it } from 'vitest'
+
+import { $freshSessionRequest, $freshSessionWorkspace, requestFreshSession } from './profile'
+
+describe('requestFreshSession workspace', () => {
+  it('carries a one-shot folder for the next fresh draft and clears it for every other caller', () => {
+    const before = $freshSessionRequest.get()
+
+    requestFreshSession(' F:\\Odysseus ')
+    expect($freshSessionWorkspace.get()).toBe('F:\\Odysseus')
+    expect($freshSessionRequest.get()).toBe(before + 1)
+
+    requestFreshSession()
+    expect($freshSessionWorkspace.get()).toBeNull()
+
+    requestFreshSession('   ')
+    expect($freshSessionWorkspace.get()).toBeNull()
+    expect($freshSessionRequest.get()).toBe(before + 3)
+  })
+})
