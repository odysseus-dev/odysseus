 // ticker by default; its toggle can reveal the activity before it settles.
+// How long a settled run took, shown only when it was long enough to matter
+// (the same 2 s quiet threshold the live activity indicator uses).
+function RunDuration({ completedAt, live, startedAt }: { completedAt?: number; live: boolean; startedAt?: number }) {
+  if (live || startedAt === undefined || completedAt === undefined) {
+    return null
+  }
+
+  const elapsed = completedAt - startedAt
+
+  if (!Number.isFinite(elapsed) || elapsed < TURN_QUIET_S) {
+    return null
+  }
+
+  const seconds = Math.round(elapsed)
+
+  return (
+    <span className={cn(SCAFFOLD_META_CLASS, 'mr-1.5')} data-slot="tool-run-duration">
+      {formatElapsed(seconds)}
+    </span>
+  )
+}
