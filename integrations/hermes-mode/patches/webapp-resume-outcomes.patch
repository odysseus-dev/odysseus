@@ -145,11 +145,42 @@ def strip_dangling_tool_call_tail(agent_history: list[dict[str, Any]]) -> list[d
     return agent_history[:-1]
 
 
+def recover_partial_tool_block(agent_history: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """A trailing ``assistant(tool_calls)`` block where the process died after SOME results were recorded.
+
+    ``strip_dangling_tool_call_tail`` only handles a block with no answers at all, so the unanswered siblings were left for the
+    pre-call sanitizer's generic stub. Give each identifiable unanswered call the same UNKNOWN/none recovery result a fully
+    dangling call gets (kept, never erased: the effect may have happened). Recorded results are untouched; a call without an
+    id cannot be paired, so it is left for ``interrupted_outcomes`` to report as unidentified."""
+    if not agent_history:
+        return agent_history
+    end = len(agent_history)
+    i = end - 1
+    while i >= 0 and isinstance(agent_history[i], dict) and agent_history[i].get("role") == "tool":
+        i -= 1
+    if i < 0 or i == end - 1:
+        return agent_history
+    block = agent_history[i]
+    if not (isinstance(block, dict) and block.get("role") == "assistant" and block.get("tool_calls")):
+        return agent_history
+    answered = {str(m.get("tool_call_id") or "") for m in agent_history[i + 1:]}
+    missing = [call for call in block.get("tool_calls") or [] if _call_id(call) and _call_id(call) not in answered]
+    if not missing:
+        return agent_history
+    recovered = list(agent_history)
+    for call in missing:
+        name = _call_name(call) or "unknown"
+        disposition, content = _orphan_recovery(name, _DANGLING_NOTICES)
+        recovered.append(make_tool_result_message(name, content, _call_id(call), effect_disposition=disposition))
+    logger.warning("Recovered %d unanswered call(s) of a partially answered tool block as UNKNOWN/none", len(missing))
+    return recovered
+
+
 def sanitize_replay_history(agent_history: list[dict[str, Any]]) -> list[dict[str, Any]]:
     """Both strippers in canonical order (interrupted blocks, then dangling tail); same list object when nothing strips."""
     if not agent_history:
         return agent_history
-    return strip_dangling_tool_call_tail(strip_interrupted_tool_tails(agent_history))
+    return recover_partial_tool_block(strip_dangling_tool_call_tail(strip_interrupted_tool_tails(agent_history)))
 
 
 def canonicalize_replay_history(
@@ -169,6 +200,7 @@ def canonicalize_replay_history(
         now = time.time()
     cleaned = strip_interrupted_tool_tails(agent_history)
     cleaned = strip_dangling_tool_call_tail(cleaned)
+    cleaned = recover_partial_tool_block(cleaned)
     return strip_stale_dangerous_confirmations(cleaned, now=now)
 
 
