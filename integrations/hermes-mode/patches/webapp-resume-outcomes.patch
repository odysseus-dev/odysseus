diff --git a/agent/interrupted_outcomes.py b/agent/interrupted_outcomes.py
new file mode 100644
index 0000000000..fe1620e5e1
--- /dev/null
+++ b/agent/interrupted_outcomes.py
@@ -0,0 +1,149 @@
+"""Per-call outcome guidance for an interrupted turn.
+
+A turn that died mid-tool-loop leaves calls whose outcome nobody recorded. ``replay_cleanup`` already gives a fully
+unanswered side-effecting call an UNKNOWN-effect result; this module names every such call in the resume note, says how to
+verify it, and keeps recorded results (success or failure) authoritative. Pure functions: nothing here runs a tool or reads
+the filesystem. Outcomes are never guessed: a call that cannot be identified is counted and reported as a limitation.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from typing import Any, Optional
+
+from agent.tool_result_classification import tool_may_have_side_effect
+
+ORPHAN_PREFIX = "[Orphan recovery:"
+STUB_PREFIX = "[Result unavailable"
+_MAX_LISTED = 8
+_SUMMARY_CHARS = 110
+_SECRET_RE = re.compile(r"(?i)\b(token|api[_-]?key|secret|passw(?:or)?d|authorization|bearer)\b(\s*[=:]\s*|\s+)\S+")
+_GIT_HISTORY_RE = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(commit|merge|rebase|cherry-pick|revert|tag|push|am)\b")
+_SHELL_TOOLS = frozenset({"terminal", "execute_code", "process", "shell"})
+_FILE_WRITE_TOOLS = frozenset({"write_file", "patch"})
+
+
+def _call_name(call: Any) -> str:
+    fn = call.get("function") if isinstance(call, dict) else None
+    return str((fn or {}).get("name") or "") if isinstance(fn, dict) else ""
+
+
+def _call_id(call: Any) -> str:
+    return str(call.get("id") or call.get("call_id") or "") if isinstance(call, dict) else ""
+
+
+def _args(call: Any) -> dict:
+    fn = call.get("function") if isinstance(call, dict) else None
+    raw = fn.get("arguments") if isinstance(fn, dict) else None
+    if isinstance(raw, dict):
+        return raw
+    try:
+        data = json.loads(raw) if isinstance(raw, str) else {}
+    except ValueError:
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def describe_call(name: str, args: dict) -> str:
+    """A short, bounded, secret-scrubbed description of what the call was about (never file contents)."""
+    for key in ("path", "file_path", "command", "url", "query", "name", "pattern"):
+        value = args.get(key)
+        if isinstance(value, str) and value.strip():
+            text = _SECRET_RE.sub(lambda m: f"{m.group(1)}=***", " ".join(value.split()))
+            return text if len(text) <= _SUMMARY_CHARS else text[: _SUMMARY_CHARS - 1] + "…"
+    return ""
+
+
+def verification_hint(name: str, args: dict) -> str:
+    """What to check before repeating a call whose effect is unknown."""
+    if name in _FILE_WRITE_TOOLS:
+        return "re-read the target file and compare it with the intended change before writing again"
+    command = str(args.get("command") or args.get("code") or "") if name in _SHELL_TOOLS else ""
+    if command and _GIT_HISTORY_RE.search(command):
+        return "check `git log -1` and `git status` (and the remote, for a push or tag) to see whether it already happened"
+    if name in _SHELL_TOOLS:
+        return "inspect what the command would change (files, `git status`, running processes) before running it again"
+    return "inspect the state this call would change before repeating it"
+
+
+def _is_unknown_result(msg: dict) -> bool:
+    content = msg.get("content")
+    text = content if isinstance(content, str) else ""
+    return (
+        msg.get("effect_disposition") == "unknown"
+        or text.startswith(ORPHAN_PREFIX) and "UNKNOWN" in text
+        or text.startswith(STUB_PREFIX)
+    )
+
+
+def _is_readonly_incomplete(msg: dict) -> bool:
+    content = msg.get("content")
+    return msg.get("effect_disposition") == "none" and isinstance(content, str) and content.startswith(ORPHAN_PREFIX)
+
+
+def unresolved_tool_calls(history: Optional[list]) -> tuple[list[dict], int]:
+    """Calls of the interrupted (last) turn with no reliably recorded outcome, plus how many calls could not be identified.
+
+    Items: ``{id, name, side_effect, summary, hint, state}`` where ``state`` is ``no_result``, ``unknown`` (recovered as
+    UNKNOWN) or ``read_only_incomplete``. Calls with a real recorded result, successful or failed, are never listed."""
+    if not history:
+        return [], 0
+    start = 0
+    for idx in range(len(history) - 1, -1, -1):
+        if isinstance(history[idx], dict) and history[idx].get("role") == "user":
+            start = idx + 1
+            break
+    turn = [m for m in history[start:] if isinstance(m, dict)]
+    results = {str(m.get("tool_call_id") or ""): m for m in turn if m.get("role") == "tool" and m.get("tool_call_id")}
+    items: list[dict] = []
+    unidentified = 0
+    for msg in turn:
+        if msg.get("role") != "assistant":
+            continue
+        for call in msg.get("tool_calls") or []:
+            name, cid = _call_name(call), _call_id(call)
+            if not name or not cid:
+                unidentified += 1
+                continue
+            result = results.get(cid)
+            if result is not None and not (_is_unknown_result(result) or _is_readonly_incomplete(result)):
+                continue
+            args = _args(call)
+            side_effect = tool_may_have_side_effect(name)
+            if result is None:
+                state = "no_result"
+            else:
+                state = "read_only_incomplete" if _is_readonly_incomplete(result) else "unknown"
+            if not side_effect and state == "no_result":
+                state = "read_only_incomplete"
+            items.append({"id": cid, "name": name, "side_effect": side_effect and state != "read_only_incomplete",
+                          "summary": describe_call(name, args), "hint": verification_hint(name, args), "state": state})
+    return items, unidentified
+
+
+def format_outcome_guidance(history: Optional[list]) -> str:
+    """The resume-note block: which calls are outcome-unknown and how to verify them. States its own limits."""
+    if history is None:
+        return ("The interrupted calls could not be listed here. Treat any step that may not have finished as outcome-unknown: "
+                "verify its effect before repeating it, and do not repeat a call whose result is already recorded.")
+    items, unidentified = unresolved_tool_calls(history)
+    lines: list[str] = []
+    unknown = [i for i in items if i["side_effect"]]
+    readonly = [i for i in items if not i["side_effect"]]
+    if unknown:
+        lines.append("Tool calls from the interrupted turn whose outcome is UNKNOWN (each may have completed, partly run, or never started):")
+        for i in unknown[:_MAX_LISTED]:
+            what = f" {i['summary']}" if i["summary"] else ""
+            lines.append(f"- {i['name']}{what} — verify first: {i['hint']}.")
+        if len(unknown) > _MAX_LISTED:
+            lines.append(f"- … and {len(unknown) - _MAX_LISTED} more; apply the same check to each.")
+        lines.append("Do not repeat an UNKNOWN call until you have verified its effect; if verification shows it did not happen, run it once.")
+    if readonly:
+        names = ", ".join(sorted({i["name"] for i in readonly}))
+        lines.append(f"Read-only calls that did not complete ({names}) had no effect and are safe to repeat if still needed.")
+    if unidentified:
+        lines.append(f"{unidentified} tool call(s) in the interrupted turn could not be identified individually (missing id or name); "
+                     "treat any step they may have performed as outcome-unknown and verify before repeating similar work.")
+    lines.append("Calls that have a recorded result, whether it succeeded or failed, are valid: do not repeat them.")
+    return " ".join(lines)
