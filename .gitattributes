# Normalize line endings so a Windows checkout (git core.autocrlf=true) can't
# corrupt shell-script shebangs. A CRLF `#!/bin/sh\r` makes the kernel look for
# an interpreter literally named "/bin/sh\r", producing the Docker startup error
# "exec /usr/local/bin/entrypoint.sh: no such file or directory" (issues #150, #77).
* text=auto

# Shell scripts must stay LF on every platform (run by sh/bash, incl. in Docker).
*.sh   text eol=lf
*.bash text eol=lf
entrypoint.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Maintained frontend modules and this lane's byte-identical deployment output.
frontend/src/** text eol=lf
static/js/actionMenuOrder.js text eol=lf
static/js/shared/domain/html.js text eol=lf
static/js/shared/domain/urlSchemes.js text eol=lf
static/js/shared/domain/relativeTime.js text eol=lf
static/js/shared/platform/clipboard.js text eol=lf
static/js/shared/platform/debounce.js text eol=lf
static/js/shared/platform/downloads.js text eol=lf
static/js/escMenuStack.js text eol=lf
static/js/shared/ui/optionNavigation.js text eol=lf
static/js/toolWindowZOrder.js text eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Vendored third-party bundles in static/lib/ are published minified artifacts
# and must stay byte-identical to what npm ships — stripping trailing whitespace
# to satisfy `git diff --check` would desync them from the upstream release. Turn
# the whitespace check off for that tree instead, and keep the bundles out of
# GitHub's language statistics.
static/lib/** -whitespace linguist-vendored

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Notes reference deployment modules.
static/js/features/notes/** text eol=lf
static/js/shared/ui/confetti.js text eol=lf

# Document editor deployment modules.
static/js/document/** text eol=lf

# Existing runtime paths of maintained shared infrastructure.
static/js/modelSort.js text eol=lf
static/js/appConfig.js text eol=lf
static/js/authStatus.js text eol=lf
static/js/platform.js text eol=lf
static/js/storage.js text eol=lf
static/js/modalSnap.js text eol=lf
static/js/modalVisibility.js text eol=lf
static/js/spinner.js text eol=lf
static/js/tourHintDismiss.js text eol=lf
static/js/windowDrag.js text eol=lf
static/js/windowResize.js text eol=lf
