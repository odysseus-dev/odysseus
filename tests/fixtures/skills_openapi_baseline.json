    "/api/skills/audit-all": {
      "post": {
        "description": "Kick off a background audit of skills: each is tested + judged; if it\nneeds work the model self-edits and retries; if a teacher model is\nconfigured it escalates; a skill that still fails is demoted to draft\n(never deleted). Poll GET /audit-status. Body:\n{scope: 'drafts'|'unchecked'|'all', names?: [...], skip_audited?: bool}. Default 'all'\nmeans every visible skill, including already-published skills, so audit\ncan publish or demote according to the confidence threshold.",
        "operationId": "audit_all_skills_api_skills_audit_all_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Audit All Skills",
        "tags": [
          "skills"
        ]
      }
    },
    "/api/skills/audit-all/cancel": {
      "post": {
        "operationId": "audit_cancel_api_skills_audit_all_cancel_post",
