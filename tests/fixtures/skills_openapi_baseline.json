        "operationId": "list_builtin_skills_api_skills_builtin_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Builtin Skills",
        "tags": [
          "skills"
        ]
      }
    },
