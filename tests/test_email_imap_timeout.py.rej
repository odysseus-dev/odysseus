+def test_open_imap_connection_coerces_starttls_off_on_port_993(monkeypatch):
+    import routes.email_helpers as helpers
+
+    _FakeIMAP.calls = []
+    monkeypatch.setattr(helpers.imaplib, "IMAP4", _FakeIMAP)
+    monkeypatch.setattr(helpers.imaplib, "IMAP4_SSL", _FakeIMAPSSL)
+
+    _open_imap_connection("mail.example.com", 993, starttls=True)
+
+    assert _FakeIMAP.calls == [
+        ("connect", "_FakeIMAPSSL", "mail.example.com", 993, _IMAP_TIMEOUT_SECONDS)
+    ]
+    assert _FakeIMAP.calls[0][1] == "_FakeIMAPSSL"
+
+
