{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Odysseus",
  "version": "0.1.0",
  "identifier": "com.odysseus.desktop",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Odysseus",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; font-src 'self' data:; media-src 'self' http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQlr/8TNiGT6ZT4KuMEc2F62GZzQ51qq/vOGxNk3E5lmfLJeH7AW/LZ",
      "endpoints": [
        "https://github.com/pewdiepie-archdaemon/odysseus/releases/latest/download/desktop-update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "autostart": null
  }
}

