{
  "name": "odysseus",
  "version": "1.1.0",
  "description": "Self-hosted AI workspace — one command to run on any machine",
  "repository": {
    "type": "git",
    "url": "https://github.com/pewdiepie-archdaemon/odysseus.git"
  },
  "bin": {
    "odysseus": "bin/cli.js"
  },
  "files": [
