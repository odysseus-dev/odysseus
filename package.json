{
  "name": "odysseus-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run build:frontend",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "verify:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-python-runtime.ps1",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-mvp.ps1",
    "tauri": "tauri",
    "tauri:dev": "npm run prepare:python && tauri dev",
    "tauri:build": "npm run prepare:python && npm run verify:python && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
