# Copy to deploy/observability/langfuse.env (gitignored). The Collector
# loads that file and no other env file. Do not point it at the Odysseus
# .env: Compose would inject every secret in that file into the Collector.
# If the Basic header lives in the overlay .env, copy this one line here.
# Value is the full OTLP Authorization header, not an Odysseus sqlite secret:
#   LANGFUSE_OTLP_AUTH=Basic base64(public_key:secret_key)
LANGFUSE_OTLP_AUTH=
