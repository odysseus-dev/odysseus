# Image pins for the unpublished observability overlay.
# Agents: keep these strings identical to docker-compose.observability.yml.
# Never a floating latest tag. Digests are required when the registry only
# publishes a moving tag (MinIO on Docker Hub is not pullable; Chainguard
# index digest below is the Langfuse upstream MinIO image).
# Verified 2026-09-24 against registry manifests / Docker Hub tag APIs.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.122.1
TEMPO_IMAGE=grafana/tempo:2.7.2
PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
GRAFANA_IMAGE=grafana/grafana:11.6.0
LANGFUSE_IMAGE=langfuse/langfuse:3.29.0
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3.29.0
# postgres:17.4 matches the week Langfuse v3.29.0 shipped (2025-02-21).
LANGFUSE_POSTGRES_IMAGE=postgres:17.4
LANGFUSE_REDIS_IMAGE=redis:7.4.2
# ClickHouse 24.8 LTS patch that existed for Langfuse v3. Not the v4 compose pin.
LANGFUSE_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8.14.39
# Index digest for cgr.dev/chainguard/minio (linux/amd64 + linux/arm64).
# docker.io/minio/minio RELEASE tags return unauthorized.
LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:bd014394a80898e68c149f2311fdf8d5a2c2f3bb2c33b9327ae6d02b4b065ae1
